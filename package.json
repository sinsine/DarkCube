{
  "name": "darkcube-diary",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "description": "墨辰DarkCube — 黑白玻璃风格的本地优先日记，GitHub 私有仓库云存档",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "icons:android": "node scripts/gen-android-icons.mjs",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.4.14",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "build": {
    "appId": "com.darkcube.diary",
    "productName": "墨辰DarkCube",
    "directories": {
      "output": "D:/Data/Documents/软件工程/成品",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DarkCubeDiary-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DarkCubeDiary-${version}-portable.${ext}"
    }
  }
}
